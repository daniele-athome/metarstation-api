{
  "name": "weather-test",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env local",
    "start": "wrangler dev --env local",
    "test": "vitest --run",
    "migrate": "wrangler d1 migrations apply weather_test --env local --local",
    "migrate:staging": "wrangler d1 migrations apply weather_staging --env staging --remote",
    "migrate:production-gallicano": "wrangler d1 migrations apply weather_gallicano --env production-gallicano --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production-gallicano": "wrangler deploy --env production-gallicano"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.1"
  },
  "dependencies": {
    "itty-router": "^5.0.22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.0": true,
    "workerd@1.20260926.1": true,
    "workerd@1.20260205.0": true,
    "sharp@0.34.5": true
  }
}
